# ======================================================================================================================
# MEMIDHelpers.cmake - embedding an identity and custom metadata from CMake
#
#   memid_embed_identity(TARGET MyMod
#       MOD_ID 6f9619ff-8b86-d011-b42d-00c04fc964ff
#       ID com.example.my-mod
#       NAME "My Mod"
#       VERSION 1.0.0
#       [PUBLISHER "Example"] [PUBLISHER_ID uuid] [HOMEPAGE url]
#       [CHANNEL stable|beta|alpha|development|nightly] [RUNTIME none|mirage|dotnet|lua]
#       [LANGUAGE c|cpp|csharp|rust|zig|d|go|pascal|other] [INTEROP_MIN n] [INTEROP_MAX n])
#
#   memid_add_custom_metadata(TARGET MyMod NAMESPACE com.example.my-mod FORMAT JSON FILE metadata.json)
#
# Both write a small C++ source into the build folder (rewritten only when its content changes) that uses
# memid/embed.hpp, and add it to the target. Values are checked when CMake runs. A custom metadata file is a configure
# dependency: editing it re-runs CMake and rebuilds that one source.
# ======================================================================================================================

include_guard(GLOBAL)

set(_MEMID_UUID_REGEX "^[0-9A-Fa-f]+-[0-9A-Fa-f]+-[0-9A-Fa-f]+-[0-9A-Fa-f]+-[0-9A-Fa-f]+$")
set(_MEMID_ID_REGEX "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$")

# A C++ raw string literal of `value` (UTF-8 source: the bytes are kept)
function(_memid_literal out value)
    if(value MATCHES "\\)memid\"")
        message(FATAL_ERROR "MEMID: a value can't contain )memid\"")
    endif()
    set(${out} "R\"memid(${value})memid\"" PARENT_SCOPE)
endfunction()

function(_memid_check_length what value max)
    string(LENGTH "${value}" length)	# Bytes
    if(length GREATER ${max})
        message(FATAL_ERROR "MEMID: ${what} is ${length} bytes (at most ${max})")
    endif()
endfunction()

function(memid_embed_identity)
    cmake_parse_arguments(ARG "" "TARGET;MOD_ID;ID;NAME;VERSION;PUBLISHER;PUBLISHER_ID;HOMEPAGE;CHANNEL;RUNTIME;LANGUAGE;INTEROP_MIN;INTEROP_MAX" "" ${ARGN})
    foreach(required TARGET MOD_ID ID NAME VERSION)
        if(NOT ARG_${required})
            message(FATAL_ERROR "memid_embed_identity: ${required} is required")
        endif()
    endforeach()
    if(NOT TARGET ${ARG_TARGET})
        message(FATAL_ERROR "memid_embed_identity: no target ${ARG_TARGET}")
    endif()
    string(LENGTH "${ARG_MOD_ID}" uuid_length)
    if(NOT ARG_MOD_ID MATCHES "${_MEMID_UUID_REGEX}" OR NOT uuid_length EQUAL 36)
        message(FATAL_ERROR "memid_embed_identity: MOD_ID ${ARG_MOD_ID} is not a UUID (xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)")
    endif()
    if(NOT ARG_ID MATCHES "${_MEMID_ID_REGEX}")
        message(FATAL_ERROR "memid_embed_identity: ID ${ARG_ID} is not a reverse-domain identifier (com.example.mod)")
    endif()
    if(NOT ARG_VERSION MATCHES "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$")
        message(FATAL_ERROR "memid_embed_identity: VERSION ${ARG_VERSION} is not MAJOR.MINOR.PATCH")
    endif()
    _memid_check_length("ID" "${ARG_ID}" 96)
    _memid_check_length("NAME" "${ARG_NAME}" 64)
    _memid_check_length("PUBLISHER" "${ARG_PUBLISHER}" 48)
    _memid_check_length("HOMEPAGE" "${ARG_HOMEPAGE}" 64)

    _memid_literal(name "${ARG_NAME}")
    _memid_literal(publisher "${ARG_PUBLISHER}")
    _memid_literal(homepage "${ARG_HOMEPAGE}")
    set(fields "    .mod_id = \"${ARG_MOD_ID}\",\n    .reverse_domain = \"${ARG_ID}\",\n    .name = ${name},\n    .publisher = ${publisher},\n    .version = \"${ARG_VERSION}\",\n    .homepage = ${homepage}")
    if(ARG_PUBLISHER_ID)
        if(NOT ARG_PUBLISHER_ID MATCHES "${_MEMID_UUID_REGEX}")
            message(FATAL_ERROR "memid_embed_identity: PUBLISHER_ID ${ARG_PUBLISHER_ID} is not a UUID")
        endif()
        string(APPEND fields ",\n    .publisher_id = \"${ARG_PUBLISHER_ID}\"")
    endif()
    if(ARG_CHANNEL)
        if(NOT ARG_CHANNEL MATCHES "^(stable|beta|alpha|development|nightly)$")
            message(FATAL_ERROR "memid_embed_identity: CHANNEL ${ARG_CHANNEL} is not stable, beta, alpha, development or nightly")
        endif()
        string(APPEND fields ",\n    .channel = ::memid::ReleaseChannel::${ARG_CHANNEL}")
    endif()
    if(ARG_LANGUAGE)
        if(NOT ARG_LANGUAGE MATCHES "^(c|cpp|csharp|rust|zig|d|go|pascal|other)$")
            message(FATAL_ERROR "memid_embed_identity: LANGUAGE ${ARG_LANGUAGE} is unknown")
        endif()
        string(APPEND fields ",\n    .language = ::memid::Language::${ARG_LANGUAGE}")
    endif()
    if(ARG_RUNTIME)
        if(NOT ARG_RUNTIME MATCHES "^(none|mirage|dotnet|lua)$")
            message(FATAL_ERROR "memid_embed_identity: RUNTIME ${ARG_RUNTIME} is not none, mirage, dotnet or lua")
        endif()
        string(APPEND fields ",\n    .runtime = ::memid::Runtime::${ARG_RUNTIME}")
    endif()
    if(DEFINED ARG_INTEROP_MIN OR DEFINED ARG_INTEROP_MAX)
        if(NOT DEFINED ARG_INTEROP_MIN)
            set(ARG_INTEROP_MIN 0)
        endif()
        if(NOT DEFINED ARG_INTEROP_MAX)
            set(ARG_INTEROP_MAX 0)
        endif()
        string(APPEND fields ",\n    .interop_min = ${ARG_INTEROP_MIN},\n    .interop_max = ${ARG_INTEROP_MAX}")
    endif()

    set(file "${CMAKE_CURRENT_BINARY_DIR}/memid_generated/${ARG_TARGET}_identity.cpp")
    file(CONFIGURE OUTPUT "${file}" CONTENT "// Generated by memid_embed_identity (MEMIDHelpers.cmake): don't edit\n#include <memid/embed.hpp>\n\nMEMID_DEFINE_IDENTITY(\n${fields});\n" @ONLY)
    target_sources(${ARG_TARGET} PRIVATE "${file}")
    target_link_libraries(${ARG_TARGET} PRIVATE memid::headers)
endfunction()

function(memid_add_custom_metadata)
    cmake_parse_arguments(ARG "" "TARGET;NAMESPACE;FORMAT;FILE" "" ${ARGN})
    foreach(required TARGET NAMESPACE FORMAT FILE)
        if(NOT ARG_${required})
            message(FATAL_ERROR "memid_add_custom_metadata: ${required} is required")
        endif()
    endforeach()
    if(NOT TARGET ${ARG_TARGET})
        message(FATAL_ERROR "memid_add_custom_metadata: no target ${ARG_TARGET}")
    endif()
    if(NOT ARG_NAMESPACE MATCHES "${_MEMID_ID_REGEX}")
        message(FATAL_ERROR "memid_add_custom_metadata: NAMESPACE ${ARG_NAMESPACE} is not a reverse-domain identifier")
    endif()
    _memid_check_length("NAMESPACE" "${ARG_NAMESPACE}" 128)
    string(TOUPPER "${ARG_FORMAT}" format)
    set(formats RAW TEXT JSON XML CBOR MSGPACK TOML)
    list(FIND formats "${format}" format_index)
    if(format_index GREATER_EQUAL 0)
        string(TOLOWER "${format}" format_name)
        set(format_expr "::memid::MetadataFormat::${format_name}")
    elseif(format MATCHES "^[0-9]+$" AND format GREATER_EQUAL 32768 AND format LESS 65536)
        set(format_expr "${format}")
    else()
        message(FATAL_ERROR "memid_add_custom_metadata: FORMAT ${ARG_FORMAT} is not RAW, TEXT, JSON, XML, CBOR, MSGPACK, TOML or a private number 32768-65535")
    endif()

    get_filename_component(source "${ARG_FILE}" ABSOLUTE)
    if(NOT EXISTS "${source}")
        message(FATAL_ERROR "memid_add_custom_metadata: ${ARG_FILE} doesn't exist")
    endif()
    file(SIZE "${source}" size)
    if(size GREATER 1048576)
        message(FATAL_ERROR "memid_add_custom_metadata: ${ARG_FILE} is ${size} bytes (readers accept 1 MiB per entry)")
    endif()
    if(format STREQUAL "JSON")
        file(READ "${source}" json)
        string(JSON ignored ERROR_VARIABLE json_error TYPE "${json}")
        if(json_error)
            message(FATAL_ERROR "memid_add_custom_metadata: ${ARG_FILE} is not valid JSON: ${json_error}")
        endif()
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")

    # The payload as a C++ byte array
    file(READ "${source}" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    get_property(count TARGET ${ARG_TARGET} PROPERTY _MEMID_CUSTOM_COUNT)
    if(NOT count)
        set(count 0)
    endif()
    math(EXPR next "${count} + 1")
    set_property(TARGET ${ARG_TARGET} PROPERTY _MEMID_CUSTOM_COUNT ${next})
    string(MAKE_C_IDENTIFIER "${ARG_TARGET}_${count}" id)

    set(file "${CMAKE_CURRENT_BINARY_DIR}/memid_generated/${ARG_TARGET}_custom_${count}.cpp")
    if(size EQUAL 0)
        set(body "MEMID_DEFINE_CUSTOM_TEXT(${id}, \"${ARG_NAMESPACE}\", ${format_expr}, \"\")\n")
    else()
        set(body "namespace { constexpr unsigned char memid_payload_${id}[] = {${bytes}}; }\nMEMID_DEFINE_CUSTOM_BYTES(${id}, \"${ARG_NAMESPACE}\", ${format_expr}, memid_payload_${id})\n")
    endif()
    file(CONFIGURE OUTPUT "${file}" CONTENT "// Generated by memid_add_custom_metadata from ${source}: don't edit\n#include <memid/embed.hpp>\n\n${body}" @ONLY)
    target_sources(${ARG_TARGET} PRIVATE "${file}")
    target_link_libraries(${ARG_TARGET} PRIVATE memid::headers)
endfunction()
