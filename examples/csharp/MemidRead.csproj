<Project Sdk="Microsoft.NET.Sdk">
  <!-- Reads a binary's MEMID identity from C# through the C ABI (P/Invoke).
       Usage: dotnet run, then the path to memid.dll and the binary as arguments -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
</Project>
